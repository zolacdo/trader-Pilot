# =====================================================================
# TradePilot Bridge - exemple de configuration
# Copier ce fichier vers  bridge/.env  puis remplacer les valeurs.
# NE JAMAIS committer le fichier .env reel.
# =====================================================================

# ---------------------------------------------------------------------
# Serveur HTTP local
# ---------------------------------------------------------------------
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# Journalisation : DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# Repertoire de donnees (base SQLite, session Telegram chiffree, logs)
DATA_DIR=./data

# ---------------------------------------------------------------------
# Base de donnees
# ---------------------------------------------------------------------
# Renseignez ces valeurs pour utiliser PostgreSQL. Laissez-les vides pour
# rester sur SQLite dans DATA_DIR : aucune installation n'est imposee.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------
# Securite
# ---------------------------------------------------------------------
# Cle maitre de chiffrement des secrets stockes en base (Fernet, 32 octets base64).
# Generer avec :  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si vide, une cle est generee automatiquement dans DATA_DIR/master.key (chmod 600).
MASTER_KEY=

# Code de pairing initial affiche au demarrage. Laisser vide pour generation aleatoire.
PAIRING_CODE=

# Origines autorisees pour CORS (rarement utile : l'app mobile n'est pas un navigateur)
CORS_ORIGINS=

# ---------------------------------------------------------------------
# ngrok - acces distant depuis le telephone
# ---------------------------------------------------------------------
NGROK_ENABLED=false
# Token de https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Domaine reserve (ngrok Free en offre 1) ex: tradepilot-xyz.ngrok-free.app
# ou votre propre domaine si vous avez un plan payant : bridge.mondomaine.com
NGROK_DOMAIN=
# Region : eu, us, ap, au, sa, jp, in
NGROK_REGION=eu
# Chemin du binaire ngrok. Vide = recherche dans le PATH puis dans DATA_DIR/bin.
NGROK_BINARY=

# ---------------------------------------------------------------------
# MetaTrader 5
# ---------------------------------------------------------------------
# Chemin du terminal64.exe. Vide = auto-detection.
MT5_TERMINAL_PATH=
# Laisser vide : connectez-vous manuellement dans MT5 Desktop (recommande).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Intervalle de rafraichissement du compte / des positions (secondes)
MT5_POLL_INTERVAL=2.0

# ---------------------------------------------------------------------
# Telegram (https://my.telegram.org -> API development tools)
# ---------------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ---------------------------------------------------------------------
# OpenRouter (https://openrouter.ai/keys)
# ---------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_PREFERRED_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_PREFERRED_VISION_MODEL=
# Ne selectionne JAMAIS automatiquement un modele payant lorsque true
OPENROUTER_FREE_ONLY=true
